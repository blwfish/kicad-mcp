# Source of truth for check-upstream-releases.yml's "current installed" baseline.
# Updated automatically by the local kicad-mcp-upstream-update.sh launchd job
# whenever it upgrades KiCad (brew cask) or FreeRouter (JAR download) on the
# dev machine. Do not hand-edit unless you're correcting a drift by hand --
# the whole point of this file is to stop that from being necessary.
KICAD_VERSION=10.0.5
FREEROUTER_VERSION=2.2.4
